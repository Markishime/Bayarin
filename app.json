{
  "expo": {
    "name": "Bayarin",
    "slug": "bayarin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "bayarin",
    "description": "Bayarin helps Filipino households organize, track, and pay their bills on time. Bayad. Organisado. Panatag.",
    "privacy": "hidden",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#102B9A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bayarin.household",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102B9A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.bayarin.household",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102B9A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#102B9A",
          "sounds": [],
          "defaultChannel": "bill-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "62507f72-986a-4596-b04d-2d2d20a02e82"
      }
    },
    "owner": "markishime"
  }
}
